{
  "name": "imark",
  "displayName": "iMark",
  "description": "%imark.description%",
  "version": "0.2.6",
  "publisher": "PORTWAYLABS",
  "license": "MIT",
  "private": true,
  "icon": "media/icons/imark.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandboxgames/imark.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "typora",
    "obsidian",
    "live preview"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "imark.editor",
        "displayName": "%imark.editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.mdown"
          },
          {
            "filenamePattern": "*.mkd"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "imark.openInIMark",
        "title": "%imark.command.openInIMark.title%",
        "category": "iMark",
        "icon": "$(book)"
      },
      {
        "command": "imark.openSource",
        "title": "%imark.command.openSource.title%",
        "category": "iMark",
        "icon": "$(go-to-file)"
      },
      {
        "command": "imark.toggleReadingView",
        "title": "%imark.command.toggleReadingView.title%",
        "category": "iMark",
        "icon": "$(open-preview)"
      },
      {
        "command": "imark.toggleSourceMode",
        "title": "%imark.command.toggleSourceMode.title%",
        "category": "iMark",
        "icon": "$(code)"
      },
      {
        "command": "imark.selectTheme",
        "title": "%imark.command.selectTheme.title%",
        "category": "iMark",
        "icon": "$(color-mode)"
      },
      {
        "command": "imark.reloadTheme",
        "title": "%imark.command.reloadTheme.title%",
        "category": "iMark"
      },
      {
        "command": "imark.toggleReadableLineWidth",
        "title": "%imark.command.toggleReadableLineWidth.title%",
        "category": "iMark"
      },
      {
        "command": "imark.importTheme",
        "title": "%imark.command.importTheme.title%",
        "category": "iMark",
        "icon": "$(cloud-download)"
      },
      {
        "command": "imark.removeTheme",
        "title": "%imark.command.removeTheme.title%",
        "category": "iMark"
      },
      {
        "command": "imark.openThemesFolder",
        "title": "%imark.command.openThemesFolder.title%",
        "category": "iMark"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "imark.toggleReadingView",
          "when": "activeCustomEditorId == imark.editor",
          "group": "navigation@1"
        },
        {
          "command": "imark.openSource",
          "when": "activeCustomEditorId == imark.editor",
          "group": "navigation@2"
        },
        {
          "command": "imark.openInIMark",
          "when": "resourceLangId == markdown && activeCustomEditorId != imark.editor",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "imark.openInIMark",
          "when": "resourceExtname =~ /\\.(md|markdown|mdown|mkd)$/",
          "group": "1_open"
        }
      ],
      "explorer/context": [
        {
          "command": "imark.openInIMark",
          "when": "resourceExtname =~ /\\.(md|markdown|mdown|mkd)$/",
          "group": "navigation@50"
        },
        {
          "command": "imark.importTheme",
          "when": "explorerResourceIsFolder || resourceExtname == .css",
          "group": "7_modification@90"
        }
      ],
      "commandPalette": [
        {
          "command": "imark.openInIMark",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "imark.openSource",
          "when": "activeCustomEditorId == imark.editor"
        },
        {
          "command": "imark.toggleReadingView",
          "when": "activeCustomEditorId == imark.editor"
        },
        {
          "command": "imark.toggleSourceMode",
          "when": "activeCustomEditorId == imark.editor"
        },
        {
          "command": "imark.toggleReadableLineWidth"
        }
      ]
    },
    "keybindings": [
      {
        "command": "imark.toggleReadingView",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeCustomEditorId == imark.editor && !imark.webviewFocus"
      }
    ],
    "configuration": {
      "title": "%imark.config.title%",
      "properties": {
        "imark.theme.name": {
          "type": "string",
          "default": "Monokai Syntax",
          "markdownDescription": "%imark.config.theme.name.description%"
        },
        "imark.theme.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "%imark.config.theme.path.description%"
        },
        "imark.theme.mode": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "description": "%imark.config.theme.mode.description%"
        },
        "imark.theme.snippets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%imark.config.theme.snippets.description%"
        },
        "imark.theme.accentColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "%imark.config.theme.accentColor.description%"
        },
        "imark.editor.defaultMode": {
          "type": "string",
          "enum": [
            "live",
            "source",
            "reading"
          ],
          "enumDescriptions": [
            "%imark.config.editor.defaultMode.enum.live%",
            "%imark.config.editor.defaultMode.enum.source%",
            "%imark.config.editor.defaultMode.enum.reading%"
          ],
          "default": "live",
          "description": "%imark.config.editor.defaultMode.description%"
        },
        "imark.editor.readableLineWidth": {
          "type": "boolean",
          "default": true,
          "description": "%imark.config.editor.readableLineWidth.description%"
        },
        "imark.editor.showInlineTitle": {
          "type": "boolean",
          "default": true,
          "description": "%imark.config.editor.showInlineTitle.description%"
        },
        "imark.editor.showHeader": {
          "type": "boolean",
          "default": true,
          "description": "%imark.config.editor.showHeader.description%"
        },
        "imark.editor.fontSize": {
          "type": "number",
          "default": 0,
          "description": "%imark.config.editor.fontSize.description%"
        },
        "imark.editor.lineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "%imark.config.editor.lineNumbers.description%"
        },
        "imark.editor.spellcheck": {
          "type": "boolean",
          "default": false,
          "description": "%imark.config.editor.spellcheck.description%"
        },
        "imark.editor.autoPairMarkdown": {
          "type": "boolean",
          "default": true,
          "description": "%imark.config.editor.autoPairMarkdown.description%"
        },
        "imark.editor.smartClickLinks": {
          "type": "boolean",
          "default": true,
          "description": "%imark.config.editor.smartClickLinks.description%"
        },
        "imark.editor.wideTables": {
          "type": "boolean",
          "default": true,
          "description": "%imark.config.editor.wideTables.description%"
        },
        "imark.attachments.folder": {
          "type": "string",
          "default": "assets",
          "description": "%imark.config.attachments.folder.description%"
        },
        "imark.attachments.linkStyle": {
          "type": "string",
          "enum": [
            "markdown",
            "wikilink"
          ],
          "default": "markdown",
          "description": "%imark.config.attachments.linkStyle.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "dev": "node esbuild.mjs --watch --dev",
    "serve": "node dev/serve.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:vscode": "node esbuild.mjs --tests && node ./out-test/runTest.js",
    "package": "npm run build && vsce package --no-dependencies",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:dry": "node scripts/release.mjs patch --dry-run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2",
    "dompurify": "3.4.15",
    "katex": "0.18.7",
    "markdown-it": "15.0.1",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/katex": "0.16.8",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.1",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "mocha": "12.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "homepage": "https://github.com/sandboxgames/imark#readme",
  "bugs": {
    "url": "https://github.com/sandboxgames/imark/issues"
  }
}
